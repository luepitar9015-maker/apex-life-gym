// APEX GYM - Motor de Base de Datos
// Plataforma Integral de Gimnasio con Inteligencia Artificial Multisede

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// Gimnasios / Sedes (Multi-tenant para Superadmin)
// -------------------------------------------------------------
model Gym {
  id             String    @id @default(uuid())
  code           String    @unique // ej: SEDE-01, SEDE-POBLADO
  name           String    // ej: "APEX Gym Sede Poblado"
  city           String    @default("Medellín")
  address        String
  phone          String?
  maxCapacity    Int       @default(80)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users          User[]
  members        Member[]
}

// -------------------------------------------------------------
// Usuarios del Sistema (Superadmin, Admin de Gym, Entrenador, Recepción)
// -------------------------------------------------------------
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN") // SUPERADMIN, ADMIN, TRAINER, RECEPTIONIST, ADMIN_TLC
  active    Boolean  @default(true)
  
  gymId     String?
  gym       Gym?     @relation(fields: [gymId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// Socios / Afiliados
// -------------------------------------------------------------
model Member {
  id               String       @id @default(uuid())
  code             String       @unique // ej: GYM-1001
  documentNumber   String       @unique
  documentType     String       @default("CC") // CC, TI, CE, PASAPORTE
  firstName        String
  lastName         String
  phone            String?
  email            String?
  birthDate        String?
  gender           String?      // MALE, FEMALE, OTHER
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  photoUrl         String?
  status           String       @default("ACTIVE") // ACTIVE, EXPIRED, PAUSED, CANCELLED
  medicalNotes     String?
  weight           Float?
  height           Float?
  notes            String?
  
  // Preferencias de alimentos del Afiliado
  likedFoods       String?      // JSON array de alimentos favoritos
  dislikedFoods    String?      // JSON array de alimentos que NO le gustan o alergias

  gymId            String?
  gym              Gym?         @relation(fields: [gymId], references: [id])

  currentPlanId    String?
  currentPlan      MembershipPlan? @relation(fields: [currentPlanId], references: [id])
  planStartDate    DateTime?
  planEndDate      DateTime?

  payments         Payment[]
  checkIns         CheckIn[]
  routines         MemberRoutine[]
  nutritionPlans   NutritionPlan[]
  diagnostics      HealthDiagnostic[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

// -------------------------------------------------------------
// Diagnóstico Fisiológico y con IA del Afiliado (Anamnesis + Escaneo)
// -------------------------------------------------------------
model HealthDiagnostic {
  id                  String   @id @default(uuid())
  memberId            String
  member              Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  photoScanUrl        String?  // Foto del socio o base64 para análisis visual corporal
  targetGoal          String   // Pérdida de grasa, Hipertrofia, Fuerza, Salud postural, etc.
  diseases            String?  // Hipertensión, Diabetes, Asma, Problemas Cardíacos, etc.
  injuries            String?  // Rodilla, Lumbar, Manguito rotador, etc.
  disabilities        String?  // Discapacidades o restricciones motoras
  trainingExperience  String?  // Sedentario, Principiante, Intermedio, Avanzado
  
  // Métricas Físicas Registradas
  bodyFatPercentage   Float?   // % de grasa estimado por IA
  muscleMassKg        Float?   // Masa magra estimada en kg
  bmi                 Float?   // Índice de masa corporal
  biotype             String?  // Ectomorfo, Mesomorfo, Endomorfo
  
  // Diagnóstico Generado por Google Gemini IA
  aiClinicalSummary   String?  // Diagnóstico fisiológico y postural
  prohibitedExercises String?  // Ejercicios estrictamente PROHIBIDOS por lesiones
  recommendedActions  String?  // Estrategia de entrenamiento sugerida

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// -------------------------------------------------------------
// Catálogo de Alimentos con Calorías y Macros
// -------------------------------------------------------------
model FoodItem {
  id        String   @id @default(uuid())
  name      String   // ej: Pechuga de pollo, Arroz integral, Aguacate
  category  String   // PROTEIN, CARB, FAT, VEGETABLE, FRUIT, DAIRY
  calories  Int      // kcal por 100g
  protein   Float    // g por 100g
  carbs     Float    // g por 100g
  fats      Float    // g por 100g
  unit      String   @default("100g")
}

// -------------------------------------------------------------
// Planes de Membresía
// -------------------------------------------------------------
model MembershipPlan {
  id              String    @id @default(uuid())
  name            String    // ej: Pase Diario, Mensual Pro, Trimestral, Anual VIP
  description     String?
  price           Float
  durationDays    Int       // ej: 1, 30, 90, 180, 365
  accessHours     String?   @default("ALL_DAY") // ALL_DAY, MORNING, NIGHT
  includesTrainer Boolean   @default(false)
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)
  
  members         Member[]
  payments        Payment[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// -------------------------------------------------------------
// Pagos y Comprobantes
// -------------------------------------------------------------
model Payment {
  id             String         @id @default(uuid())
  invoiceNumber  String         @unique // ej: REC-2026-0001
  memberId       String
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId         String?
  plan           MembershipPlan? @relation(fields: [planId], references: [id])
  amount         Float
  paymentMethod  String         @default("CASH") // CASH, CARD, TRANSFER, NEQUI_DAVIPLATA
  notes          String?
  status         String         @default("COMPLETED") // COMPLETED, VOID
  createdAt      DateTime       @default(now())
}

// -------------------------------------------------------------
// Control de Acceso y Aforo
// -------------------------------------------------------------
model CheckIn {
  id           String    @id @default(uuid())
  memberId     String
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  status       String    @default("GRANTED") // GRANTED, DENIED
  reason       String?   // ej: Membresía activa, Membresía vencida, Documento no encontrado
  zone         String    @default("GENERAL") // GENERAL, PESAS, CARDIO, CLASES
}

// -------------------------------------------------------------
// Catálogo de Ejercicios (Gimnasio y Casa)
// -------------------------------------------------------------
model Exercise {
  id          String   @id @default(uuid())
  name        String
  muscleGroup String   // CHEST, BACK, LEGS, SHOULDERS, ARMS, CORE, CARDIO
  equipment   String?  // BARBELL, DUMBBELL, MACHINE, CABLE, BODYWEIGHT, RESISTANCE_BAND, NONE
  location    String   @default("GYM") // GYM, HOME, BOTH
  description String?
  imageUrl    String?

  routineExercises RoutineExercise[]
  createdAt   DateTime @default(now())
}

model Routine {
  id           String            @id @default(uuid())
  name         String
  description  String?
  goal         String            @default("HYPERTROPHY") // HYPERTROPHY, STRENGTH, FAT_LOSS, ENDURANCE
  difficulty   String            @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED
  location     String            @default("GYM") // GYM, HOME, BOTH
  daysPerWeek  Int               @default(4)
  aiNotes      String?
  
  exercises    RoutineExercise[]
  members      MemberRoutine[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model RoutineExercise {
  id          String   @id @default(uuid())
  routineId   String
  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  dayNumber   Int      @default(1) // Día 1, 2, 3, etc.
  sets        Int      @default(4)
  reps        String   @default("10-12")
  restSeconds Int      @default(60)
  notes       String?
}

model MemberRoutine {
  id         String   @id @default(uuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  routineId  String
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  active     Boolean  @default(true)
}

// -------------------------------------------------------------
// Planes Nutricionales Inteligentes
// -------------------------------------------------------------
model NutritionPlan {
  id                 String   @id @default(uuid())
  memberId           String
  member             Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title              String   // ej: "Plan de Definición y Déficit Calórico Controlado 1900 kcal"
  targetCalories     Int
  proteinGrams       Int
  carbsGrams         Int
  fatsGrams          Int
  goal               String   // FAT_LOSS, HYPERTROPHY, RECOMPOSITION, MAINTENANCE
  mealsJson          String   // Estructura JSON con desayuno, almuerzo, meriendas y cena
  trainerNotes       String?
  generatedByAI      Boolean  @default(true)
  reviewedByTrainer  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model GymSetting {
  id             String   @id @default("singleton")
  gymName        String   @default("APEX GYM & FITNESS")
  nit            String   @default("901.884.212-9")
  phone          String   @default("+57 310 892 4410")
  address        String   @default("Av. Las Palmas #24-10, Zona Fitness")
  currency       String   @default("COP ($)")
  maxCapacity    Int      @default(80)
  alertCapacity  Int      @default(70)
  openingHours   String   @default("Lun - Vie: 5:00 AM - 10:00 PM | Sáb - Dom: 6:00 AM - 6:00 PM")
  updatedAt      DateTime @updatedAt
}

// APEX GYM - Motor de Base de Datos
// Plataforma Integral de Gimnasio

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN") // ADMIN, RECEPTIONIST, TRAINER
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id               String       @id @default(uuid())
  code             String       @unique // ej: GYM-1001
  documentNumber   String       @unique
  documentType     String       @default("CC") // CC, TI, CE, PASAPORTE
  firstName        String
  lastName         String
  phone            String?
  email            String?
  birthDate        String?
  gender           String?      // MALE, FEMALE, OTHER
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  photoUrl         String?
  status           String       @default("ACTIVE") // ACTIVE, EXPIRED, PAUSED, CANCELLED
  medicalNotes     String?
  weight           Float?
  height           Float?
  notes            String?
  
  currentPlanId    String?
  currentPlan      MembershipPlan? @relation(fields: [currentPlanId], references: [id])
  planStartDate    DateTime?
  planEndDate      DateTime?

  payments         Payment[]
  checkIns         CheckIn[]
  routines         MemberRoutine[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model MembershipPlan {
  id              String    @id @default(uuid())
  name            String    // ej: Pase Diario, Mensual Pro, Trimestral, Anual VIP
  description     String?
  price           Float
  durationDays    Int       // ej: 1, 30, 90, 180, 365
  accessHours     String?   @default("ALL_DAY") // ALL_DAY, MORNING, NIGHT
  includesTrainer Boolean   @default(false)
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)
  
  members         Member[]
  payments        Payment[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Payment {
  id             String         @id @default(uuid())
  invoiceNumber  String         @unique // ej: REC-2026-0001
  memberId       String
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId         String?
  plan           MembershipPlan? @relation(fields: [planId], references: [id])
  amount         Float
  paymentMethod  String         @default("CASH") // CASH, CARD, TRANSFER, NEQUI_DAVIPLATA
  notes          String?
  status         String         @default("COMPLETED") // COMPLETED, VOID
  createdAt      DateTime       @default(now())
}

model CheckIn {
  id           String    @id @default(uuid())
  memberId     String
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  status       String    @default("GRANTED") // GRANTED, DENIED
  reason       String?   // ej: Membresía activa, Membresía vencida, Documento no encontrado
  zone         String    @default("GENERAL") // GENERAL, PESAS, CARDIO, CLASES
}

model Exercise {
  id          String   @id @default(uuid())
  name        String
  muscleGroup String   // CHEST, BACK, LEGS, SHOULDERS, ARMS, CORE, CARDIO
  equipment   String?  // BARBELL, DUMBBELL, MACHINE, CABLE, BODYWEIGHT
  description String?
  imageUrl    String?

  routineExercises RoutineExercise[]
  createdAt   DateTime @default(now())
}

model Routine {
  id           String            @id @default(uuid())
  name         String
  description  String?
  goal         String            @default("HYPERTROPHY") // HYPERTROPHY, STRENGTH, FAT_LOSS, ENDURANCE
  difficulty   String            @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED
  daysPerWeek  Int               @default(4)
  
  exercises    RoutineExercise[]
  members      MemberRoutine[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model RoutineExercise {
  id          String   @id @default(uuid())
  routineId   String
  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  dayNumber   Int      @default(1) // Día 1, 2, 3, etc.
  sets        Int      @default(4)
  reps        String   @default("10-12")
  restSeconds Int      @default(60)
  notes       String?
}

model MemberRoutine {
  id         String   @id @default(uuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  routineId  String
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  active     Boolean  @default(true)
}

model GymSetting {
  id             String   @id @default("singleton")
  gymName        String   @default("APEX GYM & FITNESS")
  nit            String   @default("901.884.212-9")
  phone          String   @default("+57 310 892 4410")
  address        String   @default("Av. Principal #45-12, Centro Deportivo")
  currency       String   @default("COP ($)")
  maxCapacity    Int      @default(80)
  alertCapacity  Int      @default(70)
  openingHours   String   @default("Lun - Vie: 5:00 AM - 10:00 PM | Sáb - Dom: 6:00 AM - 6:00 PM")
  updatedAt      DateTime @updatedAt
}

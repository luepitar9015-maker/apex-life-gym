# Configuración de Base de Datos PostgreSQL
# Reemplaza con tus credenciales locales o tu URL de Supabase / Neon / AWS RDS
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gym_app_db?schema=public"

# JWT y Seguridad
JWT_SECRET="super-secret-gym-jwt-key-2026-secure-token"
JWT_EXPIRES_IN="7d"

# Configuración del Servidor
PORT=4000
NODE_ENV="development"

# Claves de IA (Google Gemini API para visión corporal y planes inteligentes)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
